# Tamren 18 --------------> peyada sazi range with while


def custom_range(start,stop,step):
    numbers=[]
    i = start
    if step>0:
        while i <stop:
            numbers.append(i)
            i+=step
    elif step < 0:
        while i >stop:
            numbers.append(i)
            i+=step
    return numbers

result=custom_range(2, 15, 3)
print(result)

